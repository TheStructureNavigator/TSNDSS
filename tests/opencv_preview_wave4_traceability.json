      "tests": [
        "tests.test_opencv_preview_integration.FlowTests.test_both_cameras_through_ffmpeg_with_their_own_endpoints",
        "tests.test_opencv_preview_integration.FlowTests.test_one_camera_lost_the_other_keeps_running",
        "tests.test_opencv_preview_integration.FlowTests.test_open_failure_is_contained_per_camera",
        "tests.test_opencv_preview_integration.FlowTests.test_a_stalled_stream_is_never_presented_as_fresh"
      ]
    },
    {
      "id": "PRV-S4-010",
      "text": "No command, reconnect, write or process surface: no state-changing capture property, no file or network primitive, no command vocabulary.",
      "evidence": "offline",
      "tests": [
        "tests.test_opencv_preview_boundaries.SafetyBoundaryTests.test_no_command_or_reconnect_vocabulary",
