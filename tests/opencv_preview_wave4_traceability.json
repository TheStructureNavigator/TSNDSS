        "tests.test_opencv_preview_integration.FlowTests.test_disconnect_releases_every_capture_once"
      ]
    },
    {
      "id": "PRV-S4-007",
      "text": "What cannot be interrupted is not pretended to be: a blocked read blocks its caller (no hard timeout), a concurrent close is deferred and never released underneath a running call, a concurrent second call is refused, and the pending release is visible.",
      "evidence": "offline",
      "tests": [
        "tests.test_opencv_preview_decoder.UninterruptibleCallTests.test_a_hung_read_blocks_the_calling_thread_and_the_adapter_claims_no_timeout_of_its_own",
        "tests.test_opencv_preview_decoder.UninterruptibleCallTests.test_close_during_a_blocked_read_is_deferred_never_concurrent",
        "tests.test_opencv_preview_decoder.UninterruptibleCallTests.test_a_second_concurrent_call_is_refused",
        "tests.test_opencv_preview_decoder.UninterruptibleCallTests.test_a_close_that_never_gets_its_turn_is_reported_as_pending",
        "tests.test_opencv_preview_boundaries.SafetyBoundaryTests.test_both_soft_timeouts_are_passed_and_no_hard_timeout_is_claimed",
        "tests.test_opencv_preview_boundaries.SafetyBoundaryTests.test_no_threads_are_started_and_no_process_is_spawned",
        "tests.test_opencv_preview_decoder.DeferredCloseRaceTests.test_close_arriving_just_before_the_lock_is_released_is_still_honored",
        "tests.test_opencv_preview_decoder.DeferredCloseRaceTests.test_the_same_window_during_open_and_close_paths",
        "tests.test_opencv_preview_decoder.DeferredCloseRaceTests.test_release_is_only_ever_called_with_the_lock_held"
      ]
    },
    {
      "id": "PRV-S4-008",
      "text": "The readiness gate decides first: after a refusal no decoder is created and OpenCV is neither loaded nor opened.",
