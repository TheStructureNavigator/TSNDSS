  "contract_status": "Draft",
  "note": "Wave 4 verifies the OpenCV/FFmpeg decoder adapter against a fake cv2 module and the Wave 1-3 flow over a fake transport. Every test is offline. No real OpenCV, no real RTSP connection and no hardware is involved; OpenCV behavior (timeouts, 5.x, name resolution, the Seestar RTSP server) is unverified.",
  "evidence_classes": {
    "offline": "Deterministic tests against a fake cv2 module, a fake transport and the Wave 1-3 runtime.",
    "hardware": "None. Wave 4 makes no hardware claim; hardware validation is Wave 5."
  },
  "hardware_claims": [],
  "not_claimed": {
    "hard_timeout": "The adapter provides OpenCV soft timeouts only. It gives no hard timeout and no containment of a hung capture; see docs/DB-03_OPENCV_DECODER.md.",
    "REQ-058": "Concerns Telemetry samples only (decision D3).",
    "REQ-057": "DB-04.",
    "REQ-060": "DB-04.",
    "REQ-030": "Simulator Provider obligations; the adapter is not a Simulator Provider.",
    "REQ-031": "Same as REQ-030.",
    "REQ-063": "Same as REQ-030.",
    "REQ-016": "Not claimed again here; the read-only evidence path is covered by Waves 2 and 3.",
    "hardware": "No hardware evidence of any kind is claimed."
  },
  "local_semantics": [
    {
      "id": "PRV-S4-001",
      "text": "OpenCV is an optional, lazily imported dependency: nothing is imported at package import or construction, no requirement was added, no test imports a real OpenCV, and lower layers do not know the package.",
      "evidence": "offline",
      "tests": [
        "tests.test_opencv_preview_boundaries.ImportBoundaryTests.test_opencv_is_imported_in_exactly_one_lazy_place",
        "tests.test_opencv_preview_boundaries.ImportBoundaryTests.test_no_dependency_was_added",
        "tests.test_opencv_preview_boundaries.ImportBoundaryTests.test_no_test_imports_a_real_opencv",
        "tests.test_opencv_preview_boundaries.ImportBoundaryTests.test_lower_layers_do_not_know_this_package",
        "tests.test_opencv_preview_boundaries.ImportBoundaryTests.test_importing_the_package_loads_neither_opencv_nor_numpy",
        "tests.test_opencv_preview_decoder.ImportTests.test_construction_and_import_of_the_package_load_no_opencv"
      ]
    },
    {
      "id": "PRV-S4-002",
      "text": "A missing or broken OpenCV, an unsupported or unreadable version and an incompatible module are refused with fixed categories before anything is opened.",
      "evidence": "offline",
      "tests": [
        "tests.test_opencv_preview_decoder.ImportTests.test_missing_or_broken_opencv_is_a_category_not_a_traceback",
        "tests.test_opencv_preview_decoder.ImportTests.test_default_loader_without_opencv_installed_fails_cleanly",
        "tests.test_opencv_preview_decoder.ImportTests.test_version_gate",
        "tests.test_opencv_preview_decoder.ImportTests.test_incompatible_module_is_refused",
        "tests.test_opencv_preview_integration.FlowTests.test_unavailable_opencv_is_an_open_failure_with_a_category"
      ]
    },
    {
      "id": "PRV-S4-003",
      "text": "The FFmpeg backend is requested explicitly with both soft timeouts, confirmed after opening, and never replaced by another backend; one construction only, no reconnect.",
      "evidence": "offline",
      "tests": [
        "tests.test_opencv_preview_decoder.OpenTests.test_ffmpeg_backend_is_forced_with_both_timeouts",
        "tests.test_opencv_preview_decoder.OpenTests.test_other_backend_is_never_accepted",
        "tests.test_opencv_preview_decoder.OpenTests.test_unverifiable_backend_is_refused",
        "tests.test_opencv_preview_decoder.OpenTests.test_a_decoder_is_never_reopened",
        "tests.test_opencv_preview_boundaries.SafetyBoundaryTests.test_backend_is_explicit_and_there_is_no_fallback",
        "tests.test_opencv_preview_integration.FlowTests.test_a_failed_read_is_a_lost_stream_and_the_adapter_never_reconnects"
      ]
    },
    {
      "id": "PRV-S4-004",
      "text": "Only the pixel layouts PreviewPixels supports are produced (BGR8, GRAY8); frames are validated for depth, channels, dimensions and byte size before any copy; limits are enforced.",
      "evidence": "offline",
      "tests": [
        "tests.test_opencv_preview_decoder.ReadTests.test_color_and_gray_frames",
        "tests.test_opencv_preview_decoder.ReadTests.test_unsupported_formats_and_depths",
        "tests.test_opencv_preview_decoder.ReadTests.test_oversize_frames_are_rejected_before_any_copy",
        "tests.test_opencv_preview_decoder.ReadTests.test_inconsistent_data_length_is_rejected",
        "tests.test_opencv_preview_decoder.ConfigTests.test_validation"
      ]
    },
    {
      "id": "PRV-S4-005",
      "text": "Every failure is a fixed category; OpenCV messages, the host and the RTSP address are never kept, shown or chained.",
      "evidence": "offline",
      "tests": [
        "tests.test_opencv_preview_decoder.OpenTests.test_open_failures",
        "tests.test_opencv_preview_decoder.ReadTests.test_failed_reads_are_a_lost_stream_not_a_retry",
        "tests.test_opencv_preview_decoder.RedactionTests.test_repr_hides_the_address",
        "tests.test_opencv_preview_decoder.SourceIntegrationTests.test_through_the_wave3_source_categories_survive_and_nothing_leaks",
        "tests.test_opencv_preview_integration.RedactionTests.test_no_output_reveals_the_host_or_the_address"
      ]
    },
    {
      "id": "PRV-S4-006",
      "text": "The capture is released exactly once, also after a failed open or a failing release; a failed read is a lost stream and recovery is only a new stream after new readiness evidence.",
      "evidence": "offline",
      "tests": [
        "tests.test_opencv_preview_decoder.ReleaseTests.test_close_releases_exactly_once_and_is_idempotent",
