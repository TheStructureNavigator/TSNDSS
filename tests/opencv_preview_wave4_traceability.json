      "tests": [
        "tests.test_opencv_preview_integration.GateTests.test_a_refused_gate_creates_no_decoder_and_never_loads_or_opens_opencv",
        "tests.test_opencv_preview_integration.GateTests.test_a_ready_connection_with_no_camera_evidence_opens_nothing",
        "tests.test_opencv_preview_integration.GateTests.test_building_and_polling_without_opening_touch_nothing"
      ]
    },
    {
      "id": "PRV-S4-009",
      "text": "Main and wide run independently through the adapter; a fault in one never stops the other.",
